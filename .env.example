# Public canonical origin. Override in production after a branded domain is configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only PostgreSQL connection string. Never expose this to the browser.
DATABASE_URL=postgresql://token_meter:change-me@127.0.0.1:5432/token_meter

# Production OCI example (written on the VM by ops/release.sh):
# NEXT_PUBLIC_SITE_URL=https://tokenmeter.site
# DATABASE_URL=postgresql://token_meter:<generated-secret>@127.0.0.1:5432/token_meter